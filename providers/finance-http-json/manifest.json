{
  "canonical_label": "ProviderPack.Finance.HttpJson",
  "version": "0.1.0",
  "domain": "finance",
  "provider_kind": "http-json",
  "capabilities": [
    "finance.erp.read",
    "finance.erp.write",
    "finance.ledger.query",
    "finance.report.generate",
    "finance.approval.request"
  ],
  "binding": {
    "routes": {
      "finance.erp.read": "/v1/finance/erp/read",
      "finance.erp.write": "/v1/finance/erp/write",
      "finance.ledger.query": "/v1/finance/ledger/query",
      "finance.report.generate": "/v1/finance/report/generate",
      "finance.approval.request": "/v1/finance/approval/request"
    },
    "authorization": {
      "type": "bearer",
      "secret": "api_token"
    },
    "config_headers": {
      "tenant_id": "x-h2a2h-tenant-id"
    }
  },
  "recovery": { "mode": "none" },
  "config_schema": {
    "type": "object",
    "required": ["base_url"],
    "properties": {
      "base_url": { "type": "string" },
      "tenant_id": { "type": "string" },
      "timeout_ms": { "type": "number" }
    },
    "additionalProperties": false
  },
  "secrets": [
    { "name": "api_token", "required": true }
  ],
  "runtime": {
    "network": true,
    "protocols": ["HTTP+JSON"]
  }
}
