{
  "name": "@h2a2h/reference",
  "version": "0.1.0",
  "description": "Reference implementation of the H2A2H protocol",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:reference": "node --test dist/test/*.test.js",
    "test:interop": "node --test independent/reference-b/interop.test.mjs",
    "test": "npm run test:reference && npm run test:interop",
    "conformance": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.0",
    "yaml": "^2.8.1"
  },
  "license": "Apache-2.0"
}
