{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h2a2h.dev/schemas/employee-provider-pack.schema.json",
  "title": "H2A2H Employee Provider Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canonical_label",
    "version",
    "domain",
    "provider_kind",
    "capabilities",
    "config_schema",
    "secrets",
    "runtime"
  ],
  "properties": {
    "canonical_label": {
      "type": "string",
      "pattern": "^ProviderPack\\.[A-Za-z0-9_.-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "capability_domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "provider_kind": {
      "enum": ["in-memory", "http-json", "mcp", "injected"]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routes", "authorization"],
      "properties": {
        "routes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "secret"],
          "properties": {
            "type": { "const": "bearer" },
            "secret": { "type": "string", "minLength": 1 }
          }
        },
        "config_headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+$"
          }
        }
      }
    },
    "config_schema": {
      "type": "object",
      "required": ["type", "properties", "additionalProperties"],
      "properties": {
        "type": { "const": "object" },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "enum": ["string", "number", "boolean", "object", "array"]
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "protocols"],
      "properties": {
        "network": { "type": "boolean" },
        "protocols": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    }
  }
}
