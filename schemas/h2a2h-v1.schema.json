{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h2a2h.dev/schemas/h2a2h-v1.schema.json",
  "title": "H2A2H v1 Normative Artifacts",
  "oneOf": [
    { "$ref": "#/$defs/envelope" },
    { "$ref": "#/$defs/openDelegation" },
    { "$ref": "#/$defs/openEntityChannels" },
    { "$ref": "#/$defs/proofOfHumanReturn" },
    { "$ref": "#/$defs/auditRecord" },
    { "$ref": "#/$defs/escalationRecord" },
    { "$ref": "#/$defs/openIntent" },
    { "$ref": "#/$defs/responsibilityChain" }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "entityRef": {
      "type": "object",
      "required": ["entity_id", "kind"],
      "properties": {
        "entity_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "canonical_label": { "type": "string", "minLength": 1 },
        "identity_profile": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "intentRef": {
      "type": "object",
      "required": ["canonical_label", "version"],
      "properties": {
        "canonical_label": { "type": "string", "minLength": 3 },
        "version": { "$ref": "#/$defs/semver" }
      },
      "additionalProperties": false
    },
    "responsibilitySegment": {
      "type": "object",
      "required": ["segment_id", "accountable_entity", "participant", "intent"],
      "properties": {
        "segment_id": { "type": "string", "minLength": 1 },
        "predecessor": { "type": "string", "minLength": 1 },
        "accountable_entity": { "$ref": "#/$defs/entityRef" },
        "accountable_human": { "$ref": "#/$defs/entityRef" },
        "participant": { "$ref": "#/$defs/entityRef" },
        "role": { "type": "string" },
        "intent": { "type": "string", "minLength": 1 },
        "delegation_id": { "type": "string", "minLength": 1 },
        "entered_at": { "$ref": "#/$defs/timestamp" },
        "exited_at": { "$ref": "#/$defs/timestamp" },
        "evidence": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "responsibilityChain": {
      "type": "object",
      "required": ["responsibility_chain"],
      "properties": {
        "responsibility_chain": {
          "type": "object",
          "required": ["chain_id", "segments"],
          "properties": {
            "chain_id": { "type": "string", "minLength": 1 },
            "segments": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/responsibilitySegment" }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "required": ["schema", "value"],
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "media_type": { "type": "string" },
        "value": true,
        "digest": {
          "type": "object",
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": { "type": "string" },
            "value": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "envelope": {
      "type": "object",
      "required": ["protocol", "version", "message_id", "interaction_id", "correlation_id", "kind", "intent", "sender", "receiver", "timestamp", "payload"],
      "properties": {
        "protocol": { "const": "h2a2h" },
        "version": { "$ref": "#/$defs/semver" },
        "message_id": { "type": "string", "minLength": 1 },
        "interaction_id": { "type": "string", "minLength": 1 },
        "correlation_id": { "type": "string", "minLength": 1 },
        "causation_id": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["request", "response", "event", "acknowledgement", "escalation", "proof"] },
        "intent": { "$ref": "#/$defs/intentRef" },
        "sender": { "$ref": "#/$defs/entityRef" },
        "receiver": { "$ref": "#/$defs/entityRef" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "delegation": {
          "type": "object",
          "required": ["delegation_id"],
          "properties": {
            "delegation_id": { "type": "string", "minLength": 1 },
            "chain_digest": { "type": "string" }
          },
          "additionalProperties": false
        },
        "responsibility_chain_ref": { "type": "string" },
        "payload": { "$ref": "#/$defs/payload" },
        "proofs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "ref"],
            "properties": { "type": { "type": "string" }, "ref": { "type": "string" } },
            "additionalProperties": false
          }
        },
        "trace": {
          "type": "object",
          "properties": { "trace_id": { "type": "string" }, "span_id": { "type": "string" } },
          "additionalProperties": false
        },
        "channel": {
          "type": "object",
          "required": ["profile"],
          "properties": { "profile": { "type": "string" }, "metadata": { "type": "object" } },
          "additionalProperties": false
        },
        "extensions": { "type": "object" }
      },
      "additionalProperties": false
    },
    "openDelegation": {
      "type": "object",
      "required": ["protocol", "version", "delegation_id", "delegator", "delegate", "issued_at", "expires_at", "scope", "constraints", "proof"],
      "properties": {
        "protocol": { "const": "opendelegation" },
        "version": { "$ref": "#/$defs/semver" },
        "delegation_id": { "type": "string", "minLength": 1 },
        "delegator": { "$ref": "#/$defs/entityRef" },
        "delegate": { "$ref": "#/$defs/entityRef" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "not_before": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "parent_delegation_id": { "type": "string" },
        "scope": {
          "type": "object",
          "properties": {
            "intents": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "actions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "resources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "limits": { "type": "object" }
          },
          "additionalProperties": false
        },
        "constraints": {
          "type": "object",
          "properties": {
            "max_depth": { "type": "integer", "minimum": 0 },
            "human_confirmation_required_for": { "type": "array", "items": { "type": "string" } },
            "non_delegable": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "proof": { "$ref": "#/$defs/proofRefOrValue" }
      },
      "additionalProperties": false
    },
    "channelDeclaration": {
      "type": "object",
      "required": ["channel_id", "transport", "mode", "versions", "security"],
      "properties": {
        "channel_id": { "type": "string", "minLength": 1 },
        "transport": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["request_reply", "pub_sub", "stream", "datagram"] },
        "endpoint": { "type": "object" },
        "versions": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "security": {
          "type": "object",
          "required": ["profile"],
          "properties": { "profile": { "type": "string", "minLength": 1 } },
          "additionalProperties": true
        },
        "capabilities": { "type": "object" }
      },
      "additionalProperties": false
    },
    "openEntityChannels": {
      "type": "object",
      "required": ["protocol", "version", "entity", "channels"],
      "properties": {
        "protocol": { "const": "openentitychannels" },
        "version": { "$ref": "#/$defs/semver" },
        "entity": { "$ref": "#/$defs/entityRef" },
        "channels": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/channelDeclaration" } }
      },
      "additionalProperties": false
    },
    "proofRefOrValue": {
      "type": "object",
      "required": ["profile", "value"],
      "properties": {
        "profile": { "type": "string" },
        "key_id": { "type": "string" },
        "value": { "type": "string" }
      },
      "additionalProperties": true
    },
    "proofOfHumanReturn": {
      "type": "object",
      "required": ["protocol", "version", "proof_id", "interaction_id", "target_human", "result_digest", "return_state", "channel", "presented_at", "proof_profile"],
      "properties": {
        "protocol": { "const": "h2a2h.pohr" },
        "version": { "$ref": "#/$defs/semver" },
        "proof_id": { "type": "string", "minLength": 1 },
        "interaction_id": { "type": "string", "minLength": 1 },
        "target_human": { "$ref": "#/$defs/entityRef" },
        "result_digest": {
          "type": "object",
          "required": ["algorithm", "value"],
          "properties": { "algorithm": { "type": "string" }, "value": { "type": "string" } },
          "additionalProperties": false
        },
        "return_state": { "enum": ["human_presented", "human_acknowledged"] },
        "channel": {
          "type": "object",
          "required": ["profile"],
          "properties": { "profile": { "type": "string" }, "endpoint_ref": { "type": "string" } },
          "additionalProperties": false
        },
        "presented_at": { "$ref": "#/$defs/timestamp" },
        "acknowledged_at": { "$ref": "#/$defs/timestamp" },
        "proof_profile": { "type": "string" },
        "evidence": { "$ref": "#/$defs/proofRefOrValue" },
        "evidence_ref": { "type": "string" }
      },
      "anyOf": [{ "required": ["evidence"] }, { "required": ["evidence_ref"] }],
      "additionalProperties": false
    },
    "auditRecord": {
      "type": "object",
      "required": ["audit_id", "interaction_id", "correlation_id", "event", "timestamp", "digest"],
      "properties": {
        "audit_id": { "type": "string" },
        "interaction_id": { "type": "string" },
        "correlation_id": { "type": "string" },
        "causation_id": { "type": "string" },
        "event": { "type": "string" },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "actor": { "$ref": "#/$defs/entityRef" },
        "intent": { "$ref": "#/$defs/intentRef" },
        "lifecycle": {
          "type": "object",
          "required": ["from", "to"],
          "properties": { "from": { "type": ["string", "null"] }, "to": { "type": "string" } },
          "additionalProperties": false
        },
        "delegation_ref": { "type": "string" },
        "channel_profile": { "type": "string" },
        "proof_refs": { "type": "array", "items": { "type": "string" } },
        "data": true,
        "redactions": { "type": "array", "items": { "type": "string" } },
        "previous_digest": { "type": "string" },
        "digest": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "escalationRecord": {
      "type": "object",
      "required": ["escalation_id", "interaction_id", "correlation_id", "cause", "current_state", "resume_state", "value", "attempts", "created_at", "status"],
      "properties": {
        "escalation_id": { "type": "string" },
        "interaction_id": { "type": "string" },
        "correlation_id": { "type": "string" },
        "cause": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" },
            "path": { "type": "string" },
            "evidence": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "current_state": { "type": "string" },
        "resume_state": { "type": "string" },
        "value": true,
        "attempts": { "type": "array", "items": { "type": "object" } },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "status": { "enum": ["pending_human", "resolved", "cancelled"] },
        "human_event_ref": { "type": "string" }
      },
      "additionalProperties": false
    },
    "openIntent": {
      "type": "object",
      "required": ["protocol", "version", "intent"],
      "properties": {
        "protocol": { "const": "openintent" },
        "version": { "$ref": "#/$defs/semver" },
        "intent": {
          "type": "object",
          "required": ["canonical_label", "version", "input", "output", "participants", "authority", "channels"],
          "properties": {
            "canonical_label": { "type": "string", "minLength": 3 },
            "version": { "$ref": "#/$defs/semver" },
            "input": { "type": "object", "required": ["schema"], "properties": { "schema": { "type": "string" } }, "additionalProperties": true },
            "output": { "type": "object", "required": ["schema"], "properties": { "schema": { "type": "string" } }, "additionalProperties": true },
            "participants": { "type": "array", "minItems": 1, "items": { "type": "object" } },
            "authority": { "type": "object" },
            "channels": { "type": "object" },
            "idempotency": { "type": "object" },
            "preconditions": { "type": "array", "items": { "type": "object" } },
            "postconditions": { "type": "array", "items": { "type": "object" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
