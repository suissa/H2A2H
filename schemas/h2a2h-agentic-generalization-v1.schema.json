{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://h2a2h.dev/schemas/h2a2h-agentic-generalization-v1.schema.json",
  "title": "H2A2H Agentic Generalization Profile v1",
  "oneOf": [
    { "$ref": "#/$defs/entityDiscovery" },
    { "$ref": "#/$defs/negotiationResult" },
    { "$ref": "#/$defs/delegationMandate" },
    { "$ref": "#/$defs/actionCommitment" },
    { "$ref": "#/$defs/actionMandate" },
    { "$ref": "#/$defs/actionReceipt" },
    { "$ref": "#/$defs/intentTrace" }
  ],
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" },
    "entityRef": {
      "type": "object",
      "required": ["entity_id", "kind"],
      "properties": {
        "entity_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "canonical_label": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "intentRef": {
      "type": "object",
      "required": ["canonical_label", "version"],
      "properties": {
        "canonical_label": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": ["canonical_label", "versions"],
      "properties": {
        "canonical_label": { "type": "string", "minLength": 1 },
        "versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "schema": { "type": "string", "format": "uri" },
        "spec": { "type": "string", "format": "uri" },
        "metadata": { "type": "object" }
      },
      "additionalProperties": false
    },
    "semanticExtension": {
      "type": "object",
      "required": ["canonical_label", "version", "extends"],
      "properties": {
        "canonical_label": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "extends": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "schema": { "type": "string", "format": "uri" },
        "spec": { "type": "string", "format": "uri" },
        "critical": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "handler": {
      "type": "object",
      "required": ["id", "canonical_label", "capability", "version", "spec", "config_schema", "input_schema", "output_schema", "channels", "authorization_profiles", "config"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "canonical_label": { "type": "string", "minLength": 1 },
        "capability": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "spec": { "type": "string", "format": "uri" },
        "config_schema": { "type": "string", "format": "uri" },
        "input_schema": { "type": "string", "format": "uri" },
        "output_schema": { "type": "string", "format": "uri" },
        "channels": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "authorization_profiles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "config": { "type": "object" }
      },
      "additionalProperties": false
    },
    "entityDiscovery": {
      "type": "object",
      "required": ["protocol", "entity", "transports", "capabilities"],
      "properties": {
        "protocol": {
          "type": "object",
          "required": ["name", "version", "supported_versions"],
          "properties": {
            "name": { "const": "h2a2h" },
            "version": { "type": "string" },
            "supported_versions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "entity": { "$ref": "#/$defs/entityRef" },
        "transports": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
        "extensions": { "type": "array", "items": { "$ref": "#/$defs/semanticExtension" } },
        "handlers": { "type": "array", "items": { "$ref": "#/$defs/handler" } },
        "documentation_url": { "type": "string", "format": "uri" }
      },
      "additionalProperties": false
    },
    "negotiatedCapability": {
      "type": "object",
      "required": ["canonical_label", "selected_version", "requester_versions", "provider_versions"],
      "properties": {
        "canonical_label": { "type": "string" },
        "selected_version": { "type": "string" },
        "requester_versions": { "type": "array", "items": { "type": "string" } },
        "provider_versions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "negotiationResult": {
      "type": "object",
      "required": ["status", "selected", "missing_required", "rejected", "hashes"],
      "properties": {
        "status": { "enum": ["compatible", "incompatible"] },
        "selected": { "type": "array", "items": { "$ref": "#/$defs/negotiatedCapability" } },
        "missing_required": { "type": "array", "items": { "type": "string" } },
        "rejected": { "type": "array", "items": { "type": "string" } },
        "hashes": {
          "type": "object",
          "required": ["requester_capabilities_hash", "provider_capabilities_hash", "requirements_hash", "negotiation_hash"],
          "properties": {
            "requester_capabilities_hash": { "type": "string" },
            "provider_capabilities_hash": { "type": "string" },
            "requirements_hash": { "type": "string" },
            "negotiation_hash": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "required": ["canonical_label", "path", "operator"],
      "properties": {
        "canonical_label": { "type": "string" },
        "path": { "type": "string" },
        "operator": { "enum": ["equals", "one_of", "max", "min", "contains", "exists"] },
        "value": true,
        "critical": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "delegationMandate": {
      "type": "object",
      "required": ["protocol", "version", "type", "mandate_id", "principal", "delegate", "allowed_actions", "constraints", "issued_at", "expires_at", "proof_ref"],
      "properties": {
        "protocol": { "const": "h2a2h.vaal" },
        "version": { "const": "1.0.0" },
        "type": { "const": "delegation_mandate" },
        "mandate_id": { "type": "string" },
        "principal": { "$ref": "#/$defs/entityRef" },
        "delegate": { "$ref": "#/$defs/entityRef" },
        "allowed_actions": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
        "human_confirmation_required_for": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "not_before": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "parent_mandate_hash": { "type": "string" },
        "proof_ref": { "type": "string" }
      },
      "additionalProperties": false
    },
    "actionCommitment": {
      "type": "object",
      "required": ["protocol", "version", "type", "commitment_id", "canonical_action", "principal", "agent", "provider", "target", "parameters", "intent", "negotiated_capabilities_hash", "created_at", "request_hash"],
      "properties": {
        "protocol": { "const": "h2a2h.vaal" },
        "version": { "const": "1.0.0" },
        "type": { "const": "action_commitment" },
        "commitment_id": { "type": "string" },
        "canonical_action": { "type": "string" },
        "principal": { "$ref": "#/$defs/entityRef" },
        "agent": { "$ref": "#/$defs/entityRef" },
        "provider": { "$ref": "#/$defs/entityRef" },
        "target": { "type": "object" },
        "parameters": { "type": "object" },
        "intent": { "$ref": "#/$defs/intentRef" },
        "negotiated_capabilities_hash": { "type": "string" },
        "state": {
          "type": "object",
          "required": ["before_hash"],
          "properties": {
            "before_hash": { "type": "string" },
            "version": { "type": "string" },
            "proposed_after_hash": { "type": "string" }
          },
          "additionalProperties": false
        },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "request_hash": { "type": "string" }
      },
      "additionalProperties": false
    },
    "actionMandate": {
      "type": "object",
      "required": ["protocol", "version", "type", "mandate_id", "principal", "agent", "canonical_action", "delegation_mandate_hash", "action_commitment_hash", "audience", "nonce", "issued_at", "expires_at", "max_uses", "proof_ref"],
      "properties": {
        "protocol": { "const": "h2a2h.vaal" },
        "version": { "const": "1.0.0" },
        "type": { "const": "action_mandate" },
        "mandate_id": { "type": "string" },
        "principal": { "$ref": "#/$defs/entityRef" },
        "agent": { "$ref": "#/$defs/entityRef" },
        "canonical_action": { "type": "string" },
        "delegation_mandate_hash": { "type": "string" },
        "action_commitment_hash": { "type": "string" },
        "audience": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "nonce": { "type": "string" },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" },
        "max_uses": { "type": "integer", "minimum": 1 },
        "proof_ref": { "type": "string" }
      },
      "additionalProperties": false
    },
    "actionReceipt": {
      "type": "object",
      "required": ["protocol", "version", "type", "receipt_id", "verifier", "executor", "principal", "agent", "canonical_action", "mandate_hash", "action_commitment_hash", "executed_at", "result", "result_hash", "receipt_hash"],
      "properties": {
        "protocol": { "const": "h2a2h.vaal" },
        "version": { "const": "1.0.0" },
        "type": { "const": "action_receipt" },
        "receipt_id": { "type": "string" },
        "verifier": { "$ref": "#/$defs/entityRef" },
        "executor": { "$ref": "#/$defs/entityRef" },
        "principal": { "$ref": "#/$defs/entityRef" },
        "agent": { "$ref": "#/$defs/entityRef" },
        "canonical_action": { "type": "string" },
        "mandate_hash": { "type": "string" },
        "action_commitment_hash": { "type": "string" },
        "executed_at": { "$ref": "#/$defs/timestamp" },
        "result": { "enum": ["success", "failure"] },
        "result_hash": { "type": "string" },
        "state": {
          "type": "object",
          "properties": { "before_hash": { "type": "string" }, "after_hash": { "type": "string" } },
          "additionalProperties": false
        },
        "receipt_hash": { "type": "string" }
      },
      "additionalProperties": false
    },
    "intentTrace": {
      "type": "object",
      "required": ["protocol", "version", "trace_id", "interaction_id", "intent", "actor", "transition", "reason", "occurred_at", "trace_hash"],
      "properties": {
        "protocol": { "const": "h2a2h.intent-trace" },
        "version": { "const": "1.0.0" },
        "trace_id": { "type": "string" },
        "interaction_id": { "type": "string" },
        "intent": { "$ref": "#/$defs/intentRef" },
        "actor": { "$ref": "#/$defs/entityRef" },
        "transition": {
          "type": "object",
          "required": ["from", "to"],
          "properties": { "from": { "type": ["string", "null"] }, "to": { "type": "string" } },
          "additionalProperties": false
        },
        "reason": {
          "type": "object",
          "required": ["canonical_label"],
          "properties": {
            "canonical_label": { "type": "string" },
            "summary": { "type": "string", "maxLength": 500 },
            "metadata": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
          },
          "additionalProperties": false
        },
        "failed_constraints": { "type": "array", "items": { "type": "string" } },
        "alternatives_available": { "type": "boolean" },
        "disclosure": {
          "type": "object",
          "required": ["share_with_counterparty"],
          "properties": {
            "share_with_counterparty": { "type": "boolean" },
            "allowed_fields": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "occurred_at": { "$ref": "#/$defs/timestamp" },
        "trace_hash": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
